# Scope Safari Environment Variables Template
# Copy this file to .env and fill in your credentials
# DO NOT commit the .env file - it contains sensitive credentials

# Node.js/npm
NPM_TOKEN=your_npm_token_here
NPM_EMAIL=your_email@example.com

# Python/PyPI
PYPI_USERNAME=your_pypi_username
PYPI_PASSWORD=your_pypi_password
# Or token-based authentication
PYPI_API_TOKEN=your_pypi_token_here

# Clojure/Clojars
CLOJARS_USERNAME=your_clojars_username
CLOJARS_PASSWORD=your_clojars_password
CLOJARS_GPG_KEY=your_gpg_key_id

# Maven Central
MAVEN_USERNAME=your_maven_username
MAVEN_PASSWORD=your_maven_password
MAVEN_GPG_PASSPHRASE=your_gpg_passphrase

# Emacs/MELPA
# Usually requires GitHub tokens for PRs
GITHUB_TOKEN=your_github_token_here

# Guile/Guix
# Usually requires SSH keys and GPG for package signing
GUIX_SIGNING_KEY=your_gpg_key_id

# Development environment settings
SCOPE_SAFARI_DEV_MODE=true
SCOPE_SAFARI_LOG_LEVEL=info