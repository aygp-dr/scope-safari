# Load environment variables from .env file if it exists
if [ -f .env ]; then
  source_env .env
fi

# Activate Python virtual environment if it exists
if [ -d .venv ]; then
  source .venv/bin/activate
fi

# Add local npm binaries to PATH
if [ -d node_modules/.bin ]; then
  PATH_add node_modules/.bin
fi

# Add project-specific scripts to PATH
if [ -d scripts ]; then
  PATH_add scripts
fi

# Set language-specific variables
export SCOPE_SAFARI_ROOT=$(pwd)

# Node.js
export NODE_ENV=development

# Python
export PYTHONPATH=$PYTHONPATH:$SCOPE_SAFARI_ROOT

# Echo success message
echo "Scope Safari environment activated!"